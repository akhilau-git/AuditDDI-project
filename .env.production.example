# Use with: docker compose --env-file .env.production up
# Keep the real .env.production file out of source control and store the key
# in your deployment secret manager. A blank API key deliberately prevents
# production-mode startup.

AUDITDDI_DEPLOYMENT_MODE=production
AUDITDDI_ALLOWED_ORIGINS=https://app.example.org
AUDITDDI_TRUSTED_HOSTS=app.example.org,api.example.org
AUDITDDI_ENABLE_DOCS=false
AUDITDDI_RATE_LIMIT_PER_MINUTE=60
AUDITDDI_API_KEY=
AUDITDDI_AUTH_ENABLED=true
# Host directory mounted read-only at /app/model_artifacts by Compose.
AUDITDDI_MODEL_ARTIFACT_DIR=/srv/auditddi/model_artifacts
# The selected reviewed checkpoint filename inside that directory.
AUDITDDI_CHECKPOINT_PATH=auditddi_seven_branch_candidate.pt
# Required for a seven-branch checkpoint. Place its matching, hash-verified bundle
# under the model artifact directory. Ignored by other models.
AUDITDDI_SEVEN_BRANCH_FEATURE_BUNDLE=/app/model_artifacts/seven_branch_features.npz
# Set to 1 only for a trusted checkpoint that cannot load with PyTorch's safe weights-only loader.
AUDITDDI_ALLOW_UNSAFE_PICKLE=0
# Generate a high-entropy one-time bootstrap token and store it only in your
# deployment secret manager. It creates the first administrator via /auth/bootstrap.
AUDITDDI_AUTH_BOOTSTRAP_TOKEN=
AUDITDDI_AUTH_STATE_DIR=/app/state
