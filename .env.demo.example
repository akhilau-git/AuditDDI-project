# Local research demo artifacts: place the D1 checkpoint and its matching bundle
# in ./demo_artifacts/ using their filenames from the Colab run.
AUDITDDI_MODEL_ARTIFACT_DIR=./demo_artifacts
AUDITDDI_CHECKPOINT_PATH=auditddi_seven_branch_candidate.pt
AUDITDDI_SEVEN_BRANCH_FEATURE_BUNDLE=/app/model_artifacts/seven_branch_features.npz

# Set a one-time token before bootstrapping the local administrator account.
AUDITDDI_AUTH_ENABLED=true
AUDITDDI_AUTH_BOOTSTRAP_TOKEN=replace-with-a-one-time-local-token
